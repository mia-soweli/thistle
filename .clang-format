---
AttributeMacros:
  - "tha_visibility"
  - "tha_inline"
  - "tha_inline_always"
BreakAfterReturnType: TopLevelDefinitions
BreakBeforeReturnType: TopLevelDefinitions
BreakBeforeBinaryOperators: All
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterStruct: true
  SplitEmptyFunction: true
  SplitEmptyRecord: true
IndentCaseBlocks: true
IndentCaseLabels: true
IndentWidth: 4
TabWidth: 4
UseTab: Always
...
